# API auth used by this gateway (not Gemini key)
PASSWORD=your_gateway_password

# Optional dashboard config password, defaults to PASSWORD if omitted
WEB_PASSWORD=your_dashboard_password

# User accounts and user-issued API keys
USER_DB_PATH=/hajimi/settings/users.db
USER_REGISTRATION_ENABLED=true
USER_API_KEYS_ENABLED=true
USER_API_KEY_DEFAULT_DAILY_QUOTA=1000
USER_SESSION_TTL_SECONDS=604800
USER_ADMIN_USERNAME=admin
USER_ADMIN_PASSWORD=change-this-admin-password

# Timezone
TZ=Asia/Shanghai

# Comma-separated Gemini API keys or compatible proxy tokens
GEMINI_API_KEYS=AIzaSy_xxx,AQ_xxx

# Upstream Gemini-compatible base URL
GEMINI_API_BASE_URL=https://gemini.astrbot.uk
GEMINI_API_BASE_URLS=

# Local tool calling
TOOLS_ENABLED=false
AUTO_TOOL_CALLING=true
TOOL_MAX_ROUNDS=2
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=
CODE_EXECUTION_ENABLED=false
CODE_EXECUTION_TIMEOUT=20
WEB_FETCH_TIMEOUT=10
MAX_SEARCH_RESULTS=5
TOOL_DOCUMENTS_DIR=/hajimi/settings/documents
KEY_FAILURE_COOLDOWN_SECONDS=60
KEY_QUOTA_COOLDOWN_SECONDS=3600

# Persistence
ENABLE_STORAGE=true
STORAGE_DIR=/hajimi/settings/

# Rate limits
MAX_REQUESTS_PER_MINUTE=30
MAX_REQUESTS_PER_DAY_PER_IP=600

# Obfuscation. Keep false when accurate model output matters.
RANDOM_STRING=false
RANDOM_STRING_LENGTH=5

# Concurrency
CONCURRENT_REQUESTS=1
INCREASE_CONCURRENT_ON_FAILURE=0
MAX_CONCURRENT_REQUESTS=3

# Search mode
SEARCH_MODE=false
SEARCH_PROMPT=（使用搜索工具联网搜索，需要在content中结合搜索内容）

# Vertex
ENABLE_VERTEX=false
GOOGLE_CREDENTIALS_JSON=''
ENABLE_VERTEX_EXPRESS=false
VERTEX_EXPRESS_API_KEY=
